# ════════════════════════════════════════════════════════════
# DESENVOLVIMENTO LOCAL — copie para .env e preencha os valores
# ════════════════════════════════════════════════════════════

# ── Strava OAuth ──────────────────────────────────────────────────────────────
# Crie o app em https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Local dev: aponte para o backend local
STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback
# Railway: troque pelo domínio gerado, ex:
# STRAVA_REDIRECT_URI=https://strava-analytics-backend.up.railway.app/auth/callback

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Local (Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strava_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=strava_analytics
# Railway: a variável DATABASE_URL é injetada automaticamente pelo serviço PostgreSQL.
# Você pode referenciá-la como: ${{Postgres.DATABASE_URL}}

# ── FastAPI ───────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Local:
CORS_ORIGINS=http://localhost:5173
# Railway: adicione o domínio do Vercel
# CORS_ORIGINS=http://localhost:5173,https://seu-app.vercel.app

# ── PORT (Railway injeta automaticamente — não defina em produção) ────────────
# PORT=8000

# ── ETL ───────────────────────────────────────────────────────────────────────
ETL_SCHEDULE_HOUR=2
ETL_SCHEDULE_MINUTE=0
ETL_BATCH_SIZE=100
ETL_LOG_LEVEL=INFO

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Local:
VITE_API_URL=http://localhost:8000
# Vercel: defina a variável de ambiente no dashboard da Vercel:
# VITE_API_URL=https://strava-analytics-backend.up.railway.app
